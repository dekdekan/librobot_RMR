@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(librobot_AMCL_ENABLED @LIBROBOT_AMCL_ENABLED_LITERAL@)
set(librobot_OPENCV_ENABLED @LIBROBOT_OPENCV_ENABLED_LITERAL@)
set(librobot_SKELETON_ENABLED @LIBROBOT_SKELETON_ENABLED_LITERAL@)

find_dependency(Qt6 6.5 REQUIRED COMPONENTS Core Network)
if(librobot_OPENCV_ENABLED)
    find_dependency(OpenCV 4 REQUIRED COMPONENTS
        core
        highgui
        imgcodecs
        imgproc
        videoio
    )
endif()

include("${CMAKE_CURRENT_LIST_DIR}/librobotTargets.cmake")

check_required_components(librobot)
